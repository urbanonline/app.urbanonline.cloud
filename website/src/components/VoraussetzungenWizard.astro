  // ─────────────────────────────────────────────────────────────
  const FIRMWARE_MIN = '25-04_V09';
  const STRONG_STYLE = 'style="color: #27500A; font-weight: 600;"';

  // Welche Step-IDs werden bei alma=nein übersprungen
  const SKIP_IF_NO_ALMA = new Set<StepId>(['terminal', 'firmware', 'router']);

  const wizardEl = document.getElementById('vw-wizard') as HTMLElement;
  const rawLocale = wizardEl.dataset['locale'] ?? 'de';
  const locale: Locale = (LOCALES as readonly string[]).includes(rawLocale) ? (rawLocale as Locale) : 'de';
  // Fallback-Kette für fehlende Sprachblöcke: gewählte Sprache → Englisch → Deutsch
  const t: Messages = messages[locale] ?? messages['en'] ?? messages.de;

  // Root-Sprache (de) ohne Präfix, alle anderen unter /<locale>
  const prefix = locale === 'de' ? '' : `/${locale}`;

  // App-Store: /de/ für Deutsch, sonst /us/ als universeller Fallback
  const appStoreUrl = `https://apps.apple.com/${locale === 'de' ? 'de' : 'us'}/app/urban-feed-monitor/id6746261090`;
  const playStoreUrl = `https://play.google.com/store/apps/details?id=com.app.urban_alma_pro&hl=${locale}`;

  // Platzhalter ersetzen und interne Links mit Sprachpräfix versehen
  function tx(s: string, vars: Record<string, string | number> = {}): string {
    const all: Record<string, string | number> = {
      fw: FIRMWARE_MIN,
      almaProUrl: t.almaProUrl,
      strong: STRONG_STYLE,
      ...vars,
    };
    return s
      .replace(/\{(\w+)\}/g, (m, k: string) => (k in all ? String(all[k]) : m))
      .replace(/href="\//g, `href="${prefix}/`);
  }

  const total = STEP_IDS.length;
  let current = 0;
  const answers: Partial<Record<StepId, boolean>> = {};

  const progressEl = document.getElementById('vw-progress') as HTMLElement;
  const contentEl = document.getElementById('vw-content') as HTMLElement;

  const cs = getComputedStyle(document.documentElement);
  const C = {
    bg:        cs.getPropertyValue('--sl-color-bg').trim()         || '#ffffff',
    bgSidebar: cs.getPropertyValue('--sl-color-bg-sidebar').trim() || '#f5f5f5',
    border:    cs.getPropertyValue('--sl-color-gray-5').trim()     || '#d1d5db',
    borderSub: cs.getPropertyValue('--sl-color-gray-6').trim()     || '#e5e7eb',
    text:      cs.getPropertyValue('--sl-color-text').trim()       || '#111827',
    gray2:     cs.getPropertyValue('--sl-color-gray-2').trim()     || '#6b7280',
    gray3:     cs.getPropertyValue('--sl-color-gray-3').trim()     || '#9ca3af',
    gray4:     cs.getPropertyValue('--sl-color-gray-4').trim()     || '#d1d5db',
  };

  function visibleIndex(idx: number): number {
    let skipped = 0;
    if (answers.smartphone === false)
      skipped += STEP_IDS.slice(0, idx).filter(id => id === 'appstore').length;
    if (answers.alma === false)
      skipped += STEP_IDS.slice(0, idx).filter(id => SKIP_IF_NO_ALMA.has(id)).length;
    else if (answers.internet === false)
      skipped += STEP_IDS.slice(0, idx).filter(id => id === 'router').length;
    return idx - skipped;
  }

  function visibleTotal(): number {
    let skip = 0;
    if (answers.smartphone === false) skip += 1;
    if (answers.alma === false) skip += SKIP_IF_NO_ALMA.size;
    else if (answers.internet === false) skip += 1;
    return total - skip;
  }

  function renderProgress(activeIdx: number, allDone: boolean): void {
    const vTotal = visibleTotal();
    const vActive = visibleIndex(activeIdx);
    progressEl.innerHTML = Array.from({ length: vTotal }, (_, i) => {
      let bg = C.border;
      if (allDone || i < vActive) bg = '#0F9DD8';
      else if (i === vActive) bg = '#810012';
      return `<div style="flex: 1; height: 4px; border-radius: 2px; background: ${bg}; transition: background 0.3s; margin-top: 0;"></div>`;
    }).join('');
  }

  function renderStep(): void {
    const id = STEP_IDS[current];
    const s = t.steps[id];
    const vIdx = visibleIndex(current);
    const vTot = visibleTotal();
    renderProgress(current, false);

    const hintHtml = s.hint
      ? `<div style="font-size: 0.8125rem; color: ${C.gray2}; background: ${C.bgSidebar}; border-radius: 0.5rem; padding: 0.75rem 1rem; margin-bottom: 1.25rem; line-height: 1.6;">${tx(s.hint)}</div>`
      : '';

    contentEl.innerHTML = `
      <div style="background: ${C.bg}; border: 1px solid ${C.border}; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin-bottom: 1rem;">
        <div style="font-size: 0.75rem; color: ${C.gray3}; margin-bottom: 0.25rem; text-transform: uppercase; letter-spacing: 0.05em;">${tx(t.checkpointOf, { n: vIdx + 1, total: vTot })}</div>
        <div style="font-size: 1.25rem; font-weight: 600; color: ${C.text}; margin-bottom: 0.75rem; border-bottom: 1px solid ${C.borderSub}; padding-bottom: 0.5rem;">${tx(s.title)}</div>
        <div style="font-size: 0.9375rem; color: ${C.text}; line-height: 1.6; margin-bottom: 1.25rem;">${tx(s.question)}</div>
        ${hintHtml}
        <div style="display: flex; gap: 10px;">
          <button data-answer="true" style="margin: 0; flex: 1; box-sizing: border-box; height: 2.75rem; padding: 0 1rem; border-radius: 0.5rem; border: 1px solid #3B6D11; background: ${C.bg}; color: #3B6D11; font-size: 0.9375rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;"><span class="text-2xl">✓</span> ${t.yes}</button>
          <button data-answer="false" style="margin: 0; flex: 1; box-sizing: border-box; height: 2.75rem; padding: 0 1rem; border-radius: 0.5rem; border: 1px solid #A32D2D; background: ${C.bg}; color: #A32D2D; font-size: 0.9375rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;"><span class="text-2xl">✕</span> ${t.no}</button>
        </div>
      </div>`;

    contentEl.querySelectorAll('button[data-answer]').forEach((btn) => {
      const el = btn as HTMLButtonElement;
      el.addEventListener('click', () => answer(el.dataset['answer'] === 'true'));
    });
  }

  function answer(ja: boolean): void {
    answers[STEP_IDS[current]] = ja;

    // Nächsten Schritt ermitteln – ggf. überspringen
    let next = current + 1;
    while (next < total) {
      const nextId = STEP_IDS[next];
      if (answers.smartphone === false && nextId === 'appstore') { next++; continue; }
      if (answers.alma === false && SKIP_IF_NO_ALMA.has(nextId)) { next++; continue; }
      if (answers.internet === false && nextId === 'router') { next++; continue; }
      break;
    }
    current = next;

    if (current < total) { renderStep(); } else { renderSummary(); }
  }

  // Eine Fehlermeldung im Ergebnis. footerHtml (optional) steht unter dem Text, z. B. die Store-Badges.
  function summaryItem(id: StepId, extraBody = '', footerHtml = ''): string {
    const r = t.results[id];
    const body = [tx(r.body), extraBody ? tx(extraBody) : ''].filter(Boolean).join(' ');
    return `<div style="border: 1px solid #F09595; border-left: 3px solid #A32D2D; background: #FCEBEB; border-radius: 0.5rem; padding: 0.9rem 1rem; margin-bottom: 0.75rem;">
      <div style="font-weight: 700; font-size: 0.9375rem; color: #A32D2D; margin-bottom: 0.4rem;"><span class="text-xl">⚠</span> ${tx(r.title)}</div>
      <div style="font-size: 0.8125rem; color: #501313; line-height: 1.6;${footerHtml ? ' margin-bottom: 0.75rem;' : ''}">${body}</div>
      ${footerHtml}
    </div>`;
  }

  function storeBadges(): string {
    return `<div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
          <a href="${appStoreUrl}" target="_blank" rel="noopener">
            <img src="/appstore-${locale}.svg" alt="${t.appStoreAlt}" style="height: 40px; width: auto;" />
          </a>
          <a href="${playStoreUrl}" target="_blank" rel="noopener">
            <img src="/playstore-${locale}.svg" alt="${t.playStoreAlt}" style="height: 40px; width: auto;" />
          </a>
        </div>`;
  }

  function renderSummary(): void {
    renderProgress(total, true);

    const neinSmartphone = answers.smartphone === false;
    const neinAppstore   = answers.appstore   === false;
    const neinAlma       = answers.alma       === false;
    const neinTerminal   = answers.terminal   === false;
    const neinFirmware   = answers.firmware   === false;
    const neinInternet   = answers.internet   === false;
    const neinRouter     = answers.router     === false;

    const items: string[] = [];

    if (neinSmartphone) items.push(summaryItem('smartphone'));

    if (neinAppstore && !neinSmartphone) items.push(summaryItem('appstore', '', storeBadges()));

    if (neinAlma) items.push(summaryItem('alma'));

    if (!neinAlma && neinTerminal) items.push(summaryItem('terminal'));

    if (!neinAlma && neinFirmware) {
      items.push(summaryItem('firmware', neinRouter ? t.firmwareRouterNote : ''));
    }

    if (neinInternet) items.push(summaryItem('internet'));

    if (!neinAlma && !neinInternet && neinRouter) {
      items.push(summaryItem('router', neinFirmware ? t.routerFirmwareNote : ''));
    }

    let inner = '';
    if (items.length === 0) {
      inner = `<div style="background: #EAF3DE; border: 1px solid #C0DD97; border-radius: 0.5rem; padding: 1rem 1.25rem; color: #27500A; font-size: 0.875rem; display: flex; align-items: center; gap: 10px;"><span class="text-2xl">✓</span> ${tx(t.allFulfilled)}</div>`;
    } else {
      const jaCount = Object.values(answers).filter(Boolean).length;
      if (jaCount > 0) inner = `<div style="font-size: 0.875rem; color: #92480A; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 8px;"><span class="text-2xl">⚠</span> ${tx(t.partlyFulfilled, { n: jaCount, total: Object.keys(answers).length })}</div>`;
      inner += items.join('');
    }

    contentEl.innerHTML = `
      <div style="background: ${C.bg}; border: 1px solid ${C.border}; border-radius: 0.75rem; padding: 1.25rem 1.5rem;">
        <div style="font-size: 1.125rem; font-weight: 600; margin-bottom: 1rem; color: ${C.text};">${t.result}</div>
        ${inner}
        <button id="vw-restart-btn" style="margin-top: 1.25rem; width: 100%; padding: 0.6rem; border-radius: 0.5rem; border: 1px solid ${C.gray4}; background: ${C.bgSidebar}; color: ${C.gray2}; font-size: 0.8125rem; cursor: pointer;">${t.restart}</button>
      </div>`;
    (document.getElementById('vw-restart-btn') as HTMLButtonElement).addEventListener('click', restart);
  }

  function restart(): void {
    current = 0;
    (Object.keys(answers) as StepId[]).forEach(k => delete answers[k]);
    renderStep();
  }

  renderStep();
})();
</script>
