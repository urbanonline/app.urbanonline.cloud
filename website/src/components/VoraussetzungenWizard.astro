---
// VoraussetzungenWizard.astro
// Einbindung im MDX (Pfadtiefe beachten: DE liegt eine Ebene flacher als en/, es/, fr/, ru/):
// import VoraussetzungenWizard from '../../../../components/VoraussetzungenWizard.astro';
// <VoraussetzungenWizard />
//
// Sprache: Astro.currentLocale (Root-Sprache = 'de'), clientseitig gelesen über data-locale.
const locale = Astro.currentLocale ?? 'de';
---

<div style="padding: 1.5rem 0;" id="vw-wizard" data-locale={locale}>
  <div id="vw-progress" aria-hidden="true" style="display: flex; align-items: center; gap: 6px; margin-bottom: 2rem;"></div>
  <div id="vw-content"></div>
</div>

